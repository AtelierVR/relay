{
  "name": "nox-relay",
  "version": "0.1.0",
  "description": "High-performance QUIC relay server for the Nox platform",
  "scripts": {
    "dev": "cargo build && ./target/debug/noxrelay",
    "build": "cargo build --release",
    "test": "cargo test",
    "format": "cargo fmt --all",
    "lint": "cargo clippy -- -D warnings",
    "compose": "docker build . -t noxrelay -t hactazia/noxrelay",
    "compose:dev": "docker build -f docker/Dockerfile.dev -t noxrelay:dev -t hactazia/noxrelay:dev ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AtelierVR/relay"
  },
  "keywords": [
    "quic",
    "relay",
    "server",
    "networking",
    "rust",
    "nox",
    "websocket"
  ],
  "author": "Hactazia",
  "license": "AGPL-3.0"
}
