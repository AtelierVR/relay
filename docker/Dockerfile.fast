# Dockerfile optimisé avec cargo-chef pour des builds plus rapides
# Utilise Debian au lieu d'Alpine pour une compilation plus rapide

# Stage 1: Prepare recipe
FROM rust:1.88-slim AS chef
RUN cargo install cargo-chef
WORKDIR /app

# Stage 2: Build recipe
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Build dependencies
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
# Build dependencies - ce layer sera caché
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo chef cook --release --recipe-path recipe.json

# Build application
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release

# Stage 4: Runtime
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/noxrelay ./noxrelay
EXPOSE 23032/udp
ENTRYPOINT ["./noxrelay"]
